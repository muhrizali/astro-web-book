---
import { Icon } from 'astro-icon/components';

type CalloutType = "neutral" | "info" | "success" | "warning" | "danger";

interface Props {
    kind: CalloutType;
    title: string | null;
}

let { kind = "neutral", title = null } = Astro.props;

function getIcon(kind: CalloutType) {
    switch(kind) {
        case "neutral":
            title = title ?? "Note";
            return "info";
        case "info":
            title = title ?? "Info";
            return "lightbulb";
        case "success":
            title = title ?? "Tip";
            return "check-circle";
        case "warning":
            title = title ?? "Warning";
            return "warning";
        case "danger":
            title = title ?? "Danger";
            return "dangerous";
    }
}
/*
    note: info
    tip: lightbulb / tips / tooltip
    success: check-circle
    error: warning / error
*/

---

<aside
    data-kind={kind}
    class={`callout callout-${kind}`}>
    <div 
        class={`callout-title callout-title-${kind}`}>
        <span>
            <Icon class="" name={`material-symbols:${getIcon(kind)}`} />
        </span>
        <span>
            {title}
        </span>
    </div>
    <div 
        class="callout-body">
        <slot></slot>
    </div>
</aside>