---
import TOC from "../components/TOC.astro";
const links = [
    { label: "Home", link: "/" },
    { label: "Book", link: "/book" },
    { label: "Blog", link: "/blog" },
    { label: "About", link: "/about" },
];
---

<ul
    class="w-fit flex flex-row sm:flex-col gap-2 sm:gap-1 text-body-muted font-semibold font-mono">
    {
        links.map((item) => (
            <li>
                <a href={item.link} class="link-behavior uppercase">
                    {item.label}
                </a>
            </li>
        ))
    }
</ul>
