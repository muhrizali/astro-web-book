---

import TOC from "../components/TOC.astro";
const links = [
    { label: "Home", link: "/" },
    { label: "Book", link: "/book" },
    { label: "Blog", link: "/blog" },
    { label: "About", link: "/about" },
];
---

<nav
    id="ui-left-sidebar"
    class="hidden sm:block flex-none px-6 py-4 border-default-edge border-x-2 bg-surface-secondary/40 min-w-60 max-w-fit">
    <header class="mb-2">
        <p class="text-2xl/tight font-bold text-body-muted">
            HEADER
        </p>
    </header>
    <ul
        class="w-fit flex flex-row sm:flex-col gap-2 sm:gap-1 text-body-muted font-semibold font-mono">
    {
        links.map((item) => (
            <li>
                <a href={item.link} class="link-behavior uppercase">
                    {item.label}
                </a>
            </li>
        ))
    }
    </ul>
</nav>