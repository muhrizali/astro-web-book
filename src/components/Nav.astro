---

import Header from "../components/Header.astro";


const links = [
    { id: "home", label: "Home", link: "/" },
    { id: "book", label: "Book", link: "/book" },
    { id: "blog", label: "Blog", link: "/blog" },
    { id: "about", label: "About", link: "/about" },
];

function currentPage(linkPath: string) {
    const currentPath = Astro.url.pathname;
    if (linkPath !== "/") {
        return currentPath.startsWith(linkPath);
    } else {
        return currentPath === "/";
    }
}
---

<nav
    class="flex-none px-4 pb-4 pt-6 border-default-edge border-y-2 bg-surface-soft w-full h-fit">
    <div class="max-w-3xl mx-auto">
        <Header />
        <ul
            class="w-full sm:w-fit flex flex-row sm:flex-row gap-3 text-body-muted font-semibold font-mono">
            {
                links.map((item) => (
                    <li>
                        <a 
                            href={item.link}
                            data-current={currentPage(item.link)} 
                            class="link-behavior uppercase">
                                {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>