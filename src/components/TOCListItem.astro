---
import TOCListItemTopics from './TOCListItemTopics.astro';
import { render } from 'astro:content';

interface Props {
    item: any;
    showTopics: boolean;
    current: any | null;
}

const { item, current, showTopics } = Astro.props;

---

<li class="">
    <!-- PAGE -->
    {
        (item.data["type"] === "PAGE") && (
            <a  
                data-astro-prefetch="false"
                data-current={(item.id === current?.id) ? "true" : "false"}
                href={`/book/${item.id}`} class="link-behavior">
                {item.data["title"]}
            </a>
        )
    }

<!-- PART -->
{
    (item.data["type"] === "PART") && (
        <a  
            data-astro-prefetch="false"
            data-current={(item.id === current?.id) ? "true" : "false"}
            href={`/book/${item.id}`} 
            class="inline-block mt-2 link-behavior font-medium">
                Part {item.data["partNum"]}: {item.data["title"]}
            </a>

        )
    }

    <!-- CHAPTER -->
    {
        (item.data["type"] === "CHAPTER") && (
            <div class="flex flex-row">
                <span class="pr-4">{item.data["chapterNum"]}.</span>
                
                <div class="block">
                    <a 
                        data-astro-prefetch="false"
                        data-current={(item.id === current?.id) ? "true" : "false"}
                        href={`/book/${item.id}`} 
                        class="link-behavior">
                        {item.data["title"]}
                    </a>

                    {/* { showTopics && (
                        <TOCListItemTopics item={item} />
                    ) } */}
                </div>
            </div>
        )
    }
</li>
