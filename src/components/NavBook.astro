---
import { Icon } from "astro-icon/components";
import TOC from "../components/TOC.astro";
import { Node } from "../scripts/utils";

interface Props {
    itemNode: Node;
}

const { itemNode } = Astro.props;

---

<div 
    class="border-t-2 mb-4 border-default-edge mx-auto w-full flex flex-col justify-between select-none">
    <div class="mt-4">
        <details class="group border-2 border-default-edge rounded-xs text-body-muted font-mono">
            <summary class="py-1 px-3 cursor-pointer font-medium">
                <span class="ml-1 font-bold">Contents: </span>
                <span class="group-open:hidden text-primary">
                    {itemNode.value.data["title"]}
                </span>
            </summary>
            <div class="px-5 text-sm">
                <TOC currentNode={itemNode} />
            </div>
        </details>
    </div>
    <div 
        class="mt-4 flex flex-row space-x-0 justify-between">
        <div>
            <a
                href={`/book/${itemNode.leftNode?.value.id ?? ''}`}
                class="btn flex flex-row justify-center items-center">
                <span>
                    <Icon name="material-symbols:arrow-circle-left" />
                </span>
                <span class="ml-1">BACK</span>
            </a>
        </div>
        <div>
            <a
                href={`/book/${itemNode.rightNode?.value.id ?? ''}`}
                class="btn flex flex-row justify-center items-center">
                <span class="mr-1">NEXT</span>
                <span>
                    <Icon name="material-symbols:arrow-circle-right" />
                </span>
            </a>
        </div>
    </div>
</div>
