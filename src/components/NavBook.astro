---
import { Icon } from "astro-icon/components";
import TOC from "../components/TOC.astro";
import { Node } from "../scripts/utils";

interface Props {
    itemNode: Node;
}

const { itemNode } = Astro.props;

---

<div class="border-t-2 border-default-edge mx-auto w-full flex flex-col justify-between select-none">
    <div class="py-4 flex flex-row space-x-0 justify-between">
        <div>
            <a
                href={`/book/${itemNode.leftNode?.value.id ?? ''}`}
                class="btn flex flex-row justify-center items-center">
                <span>
                    <Icon
                        class=""
                        name="material-symbols:arrow-circle-left"
                    />
                </span>
                <span class="ml-1">PREV</span>
            </a>
        </div>
        <div>
            <a
                href={`/book/${itemNode.rightNode?.value.id ?? ''}`}
                class="btn flex flex-row justify-center items-center">
                <span class="mr-1">NEXT</span>
                <span>
                    <Icon name="material-symbols:arrow-circle-right" />
                </span>
            </a>
        </div>
    </div>
    <div class="border-0 mb-4">
        <details class="group border-2 border-default-edge rounded-sm text-body-muted text-sm font-mono">
            <summary class="py-2 px-3 font-medium cursor-pointer">
                <span>Contents: </span>
                <span class="group-open:hidden decoration-2 decoration-dotted decoration-primary underline">
                    {itemNode.value.data["title"]}
                </span>
            </summary>
            <div class="px-4">
                <TOC/>
            </div>
        </details>
    </div>
</div>
