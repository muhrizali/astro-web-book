---
import TOCListItem from "./TOCListItem.astro";
import { getUnitNodesCollection, Node } from "../scripts/utils";
import type { CollectionEntry } from "astro:content";

const nodesCollection = await getUnitNodesCollection();

interface Props {
    showTopics?: boolean;
    currentNode?: Node<CollectionEntry<'UNITS'>>;
}

const { showTopics = false, currentNode = null } = Astro.props;
---

<ul class="mb-4 font-mono text-body">
    {
        nodesCollection.map((node) => (
            <TOCListItem current={currentNode?.value} item={node.value} showTopics={showTopics} />
        ))
    }
</ul>
