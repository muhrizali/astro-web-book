---
import "../styles/global.css";
import Head from "../components/Head.astro";

interface Props {
    metadata: any;
}

const { metadata } = Astro.props;

---

<!doctype html>
<html 
	lang="en"
	data-color-scheme="light">
	<Head metadata={metadata} />
	<body
		hx-boost:inherited="true"
		class="border-0 flex flex-col justify-start items-center w-full bg-surface h-full min-h-screen overflow-y-auto">
		<!-- default width: max-w-3xl -->
		<slot />
	</body>
</html>