---
import SitePage from "./SitePage.astro";
import Prose from "../components/Prose.astro";
import NavBook from "../components/NavBook.astro";
import { Node } from "../scripts/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
    itemNode: Node<CollectionEntry<"UNITS">>;
    metadata: any;
}

const { itemNode, metadata } = Astro.props;

---
<SitePage metadata={metadata}>
    <slot></slot>
    <NavBook itemNode={itemNode} />
</SitePage>