---
import { render } from 'astro:content';
import { getUnitCollection, getUnitCollectionItem, Node } from '../../scripts/utils';
import BookPage from '../../layouts/BookPage.astro';
import Prose from '../../components/Prose.astro';

export async function getStaticPaths () {
    const allUnitNodes = await getUnitCollection();
    return allUnitNodes.map((node: Node) => ({ params: { 'slug': node.value['id'] } }));
}

const { slug } = Astro.params;
const unitNode = await getUnitCollectionItem(slug);

if (!unitNode) {
    throw new Error("Collection Item Not Found");
}

const { Content } = await render(unitNode.value);

---

<BookPage itemNode={unitNode}>
    <div class="mt-4 mb-10 font-serif text-xl">
        <!-- Chapter Header -->
        { (unitNode.value.data["type"] === "CHAPTER") && (
            <p class="text-body-muted italic mb-0 font-medium">
                Chapter {unitNode.value.data["chapterNum"]}
            </p>
        ) }

        <!-- Part Header -->
        { (unitNode.value.data["type"] === "PART") && (
            <p 
                class="text-body-muted italic mb-0 font-medium">
                Part {unitNode.value.data["partNum"]}
            </p>
        ) }

        <h1 class="uppercase text-4xl font-bold text-body-strong font-sans tracking-tight">{unitNode.value.data["title"]}</h1>
    </div>
    <Prose>
        <Content />
    </Prose>
</BookPage>